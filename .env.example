# Copy to .env. Read by `docker compose` (interpolation) and by the app when run locally.
# No secrets here: change POSTGRES_PASSWORD for anything beyond local development.

# Postgres (docker compose)
POSTGRES_USER=curio
POSTGRES_PASSWORD=curio
POSTGRES_DB=curio
POSTGRES_PORT=5432

# Process counts (docker compose)
API_WORKERS=2
WORKER_REPLICAS=1
API_PORT=8000

# App settings (env names match curio.settings.Settings fields)
# When running on the host against the compose Postgres:
DATABASE_URL=postgresql://curio:curio@localhost:5432/curio
LOG_LEVEL=INFO
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=5
# WORKER_HEARTBEAT_SECONDS=30
# TMDB request budget, split evenly across worker processes. Under compose, the split comes
# from WORKER_REPLICAS (above); compose ignores WORKER_PROCESS_COUNT in .env and does not
# see `--scale`. WORKER_PROCESS_COUNT only matters when you run workers outside compose.
# TMDB_REQUESTS_PER_SECOND_TOTAL=40
# WORKER_PROCESS_COUNT=1

# Process-split sealed-box keypair (generate with `uv run curio keygen`).
# API receives only KEY_PUBLIC_KEY; worker receives KEY_PRIVATE_KEY.
KEY_PUBLIC_KEY=
KEY_PRIVATE_KEY=

# Control-plane sessions & public addon URL
# SESSION_COOKIE_SECURE=true
# PUBLIC_BASE_URL=https://curio.example.com

# Simkl (#6). Register a "Server apps & services" app at https://simkl.com/settings/developer/ and
# register the redirect URI <PUBLIC_BASE_URL>/api/simkl/callback there, exactly.
# The API and the worker both need the client ID and secret.
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
# Overrides PUBLIC_BASE_URL + /api/simkl/callback. For local development register
# http://localhost/api/simkl/callback at Simkl (it ignores the port on loopback) and set the real
# port here, because the same URI is sent when the code is exchanged:
# SIMKL_REDIRECT_URI=http://localhost:8000/api/simkl/callback

# Integration tests use this if set; otherwise they start a throwaway container.
# TEST_DATABASE_URL=postgresql://curio:curio@localhost:5432/curio_test
