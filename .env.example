# Copy to .env. Read by `docker compose` (interpolation) and by the app when run locally.
# No secrets here: change POSTGRES_PASSWORD for anything beyond local development.

# Postgres (docker compose)
POSTGRES_USER=curio
POSTGRES_PASSWORD=curio
POSTGRES_DB=curio
POSTGRES_PORT=5432

# Process counts (docker compose)
API_WORKERS=2
WORKER_REPLICAS=1
API_PORT=8000

# App settings (env names match curio.settings.Settings fields)
# When running on the host against the compose Postgres:
DATABASE_URL=postgresql://curio:curio@localhost:5432/curio
LOG_LEVEL=INFO
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=5
# WORKER_HEARTBEAT_SECONDS=30

# Integration tests use this if set; otherwise they start a throwaway container.
# TEST_DATABASE_URL=postgresql://curio:curio@localhost:5432/curio_test
